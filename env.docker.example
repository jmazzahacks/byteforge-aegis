# ByteForge Aegis Docker Environment Configuration
# Copy this file to .env when using Docker Compose

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Security Keys (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
MASTER_API_KEY=your-master-api-key-here-generate-with-openssl-rand-hex-32

# Database Configuration (point at your existing Postgres host)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=aegis
DB_USER=aegis_admin
DB_PASSWORD=your-secure-database-password-here

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ByteForge Aegis

# Frontend URL (used for links in verification / password-reset emails)
AEGIS_FRONTEND_URL=https://your-frontend.example.com

# App bind (inside the container)
APP_HOST=0.0.0.0
APP_PORT=5678

# Token Expiration (in seconds)
AUTH_TOKEN_EXPIRATION=3600
EMAIL_VERIFICATION_EXPIRATION=86400
PASSWORD_RESET_EXPIRATION=3600
EMAIL_CHANGE_EXPIRATION=3600

# CORS Configuration
# LEAVE THIS UNSET. Unset is the secure default: allowed origins are derived
# from each site's frontend_url in the database, so tenants are permitted
# automatically and a new one needs no config change or restart.
#
# Setting it overrides that derivation entirely. In particular CORS_ORIGINS=*
# allows every origin — this file shipped that value, so the wildcard was the
# deployed policy on every install rather than a development default, and it
# silently defeated the database-derived allow-list when that was added.
#
# Only set it to pin an explicit comma-separated list, e.g.
#   CORS_ORIGINS=https://app1.example.com,https://app2.example.com
# For origins that are nobody's frontend_url (the admin console, local dev),
# prefer CORS_EXTRA_ORIGINS, which ADDS to the derived list instead of
# replacing it:
#   CORS_EXTRA_ORIGINS=http://localhost:3000

# Logging
# DEBUG_LOCAL=true for console logs (local dev), false for Loki shipping (production)
# When DEBUG_LOCAL=false, all LOKI_* variables below are required.
DEBUG_LOCAL=false
LOG_LEVEL=INFO
LOKI_ENDPOINT=
LOKI_USER=
LOKI_PASSWORD=
LOKI_CA_BUNDLE_PATH=/app/certs/loki-ca.pem
